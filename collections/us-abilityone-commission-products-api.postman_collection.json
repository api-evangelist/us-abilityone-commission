          "id": "fae6ae83-677e-4a36-b729-c1bb86e5ecdf",
          "name": "AbilityOne Search Procurement List Products",
          "request": {
            "name": "AbilityOne Search Procurement List Products",
            "description": {
              "content": "Search the AbilityOne Procurement List for products by National Stock Number (NSN), description, agency, or nonprofit affiliate. Returns products that federal agencies are mandated to procure through the AbilityOne program.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "products"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "nsn",
                  "value": "<string>",
                  "description": "National Stock Number (format xxxx-xx-xxx-xxxx)"
                },
                {
                  "disabled": false,
                  "key": "description",
                  "value": "<string>",
                  "description": "Product description keyword search (supports wildcards)"
                },
                {
                  "disabled": false,
                  "key": "nonprofit",
                  "value": "<string>",
                  "description": "Filter by nonprofit affiliate (NIB or SourceAmerica)"
                },
                {
                  "disabled": false,
                  "key": "agency",
                  "value": "<string>",
                  "description": "Filter by performing nonprofit agency name"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Maximum number of results to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
